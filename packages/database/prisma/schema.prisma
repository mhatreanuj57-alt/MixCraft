generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  github
  npm
  vercel
}

enum ConnectionStatus {
  connected
  disconnected
  pending
  expired
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  githubUserId String    @unique @map("github_user_id")
  githubLogin  String    @map("github_login")
  displayName  String?   @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  sessions             Session[]
  providerConnections  ProviderConnection[]
  auditEvents          AuditEvent[]

  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  sessionHash String    @unique @map("session_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ProviderConnection {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  provider            Provider
  providerAccountId   String           @map("provider_account_id")
  providerAccountName String?          @map("provider_account_name")
  status              ConnectionStatus @default(pending)
  scopes              String[]
  lastValidatedAt     DateTime?        @map("last_validated_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  disconnectedAt      DateTime?        @map("disconnected_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedCredentials EncryptedCredential?
  githubInstallations  GithubInstallation[]
  resourceCache        ResourceCache[]
  auditEvents          AuditEvent[]

  @@unique([userId, provider, providerAccountId])
  @@index([provider, status])
  @@map("provider_connections")
}

model EncryptedCredential {
  id                String   @id @default(uuid()) @db.Uuid
  connectionId      String   @unique @map("connection_id") @db.Uuid
  credentialKind    String   @map("credential_kind")
  ciphertext        Bytes
  nonce             Bytes
  authenticationTag Bytes    @map("authentication_tag")
  keyVersion        Int      @default(1) @map("key_version")
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("encrypted_credentials")
}

model OauthTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  provider              Provider
  stateHash             String   @unique @map("state_hash")
  pkceVerifierCiphertext Bytes?   @map("pkce_verifier_ciphertext")
  browserSessionBinding String?  @map("browser_session_binding")
  createdAt             DateTime @default(now()) @map("created_at")
  expiresAt             DateTime @map("expires_at")
  consumedAt            DateTime? @map("consumed_at")

  @@index([expiresAt])
  @@map("oauth_transactions")
}

model GithubInstallation {
  id             String   @id @default(uuid()) @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  installationId BigInt   @unique @map("installation_id")
  accountType    String   @map("account_type")
  accountLogin   String   @map("account_login")
  suspendedAt    DateTime? @map("suspended_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("github_installations")
}

model ResourceCache {
  id                 String   @id @default(uuid()) @db.Uuid
  connectionId       String   @map("connection_id") @db.Uuid
  provider           Provider
  resourceType       String   @map("resource_type")
  providerResourceId String   @map("provider_resource_id")
  payload            Json
  fetchedAt          DateTime @default(now()) @map("fetched_at")
  expiresAt          DateTime @map("expires_at")

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, resourceType, providerResourceId])
  @@index([expiresAt])
  @@map("resource_cache")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  connectionId String?  @map("connection_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  outcome      String
  requestId    String?  @map("request_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  connection ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([connectionId])
  @@map("audit_events")
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       Provider
  providerEventId String   @map("provider_event_id")
  eventType      String    @map("event_type")
  receivedAt     DateTime  @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")
  status         String    @default("received")

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}
